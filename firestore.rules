rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cathay Bank Online Banking - Secure Backend Service Layer
    // When operating behind the Express proxy server, server requests are permitted
    // while client browser access is mediated by the Node backend API endpoints.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

