# Twilio configuration for sending real SMS verification codes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend configuration for transactional email dispatch
RESEND_API_KEY=
EMAIL_FROM=notifications@cathabankusa.com
EMAIL_REPLY_TO=support@cathabankusa.com
SUPPORT_EMAIL=support@cathabankusa.com
RESEND_FROM_EMAIL=notifications@cathabankusa.com

# Prototype Administrator Credentials
ADMIN_EMAIL=admin@cathaybank.com
ADMIN_PASSWORD=admin

# Alternative: SendGrid configuration
SENDGRID_API_KEY=

# Production Domain Configuration
CUSTOM_DOMAIN=cathabankusa.com
APP_URL=https://cathabankusa.com

# Google Cloud Run Deployment Region (Oregon - supports custom domain mappings)
CLOUD_RUN_REGION=us-west1
GCP_REGION=us-west1
