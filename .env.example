# Twilio configuration for sending real SMS verification codes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend configuration for sending real Email verification codes
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@cathaybankusa.com
SUPPORT_EMAIL=support@cathaybankusa.com
ADMIN_EMAIL=admin@cathaybank.com

# Alternative: SendGrid configuration
SENDGRID_API_KEY=

# Production Domain Configuration
CUSTOM_DOMAIN=cathaybankusa.com
APP_URL=https://cathaybankusa.com

# Google Cloud Run Deployment Region (Oregon - supports custom domain mappings)
CLOUD_RUN_REGION=us-west1
GCP_REGION=us-west1
