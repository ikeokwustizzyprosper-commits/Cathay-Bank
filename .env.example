# Twilio configuration for sending real SMS verification codes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend configuration for transactional email dispatch
RESEND_API_KEY=
EMAIL_FROM=notifications@cathaybankusa.com
EMAIL_REPLY_TO=support@cathaybankusa.com
SUPPORT_EMAIL=support@cathaybankusa.com
SUPPORT_GMAIL=supportcathaybankusa@gmail.com
RESEND_FROM_EMAIL=notifications@cathaybankusa.com

# Required administrator credentials (use a strong secret in deployment)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Alternative: SendGrid configuration
SENDGRID_API_KEY=

# Production Domain Configuration
CUSTOM_DOMAIN=cathaybankusa.com
APP_URL=https://cathaybankusa.com

# Google Cloud Run Deployment Region (Oregon - supports custom domain mappings)
CLOUD_RUN_REGION=us-west1
GCP_REGION=us-west1
